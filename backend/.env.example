PORT=3000
NODE_ENV=development
# URI de MongoDB Atlas (con usuario y contraseña). NUNCA commitear el valor real.
MONGODB_URI=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# URL publica del FRONT (las requests a /api llegan por el proxy). Local: http://localhost:5173
BETTER_AUTH_URL=http://localhost:5173
# OAuth App de GitHub (una para local y otra para produccion)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth Client de Google (Google Cloud Console → APIs y servicios → Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gemini (LLM del agente). Key en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: cualquier modelo de Gemini con tool calling
GEMINI_MODEL=gemini-3.5-flash-lite
# Usuarios de prueba que crea `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
